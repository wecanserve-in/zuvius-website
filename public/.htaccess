# ------------------------------------------------------------------
# Server rules for zuviuslifesciences.in (Hostinger). Copied into build/ by
# `npm run build`, so it is deployed with the site.
#   1. Sends www visitors to https://zuviuslifesciences.in
#   2. Serves the ready-made page for each address (<address>/index.html)
#   3. Returns a real "404 Not Found" for wrong addresses
#   4. Adds standard security headers
#   5. Lets browsers cache files properly
# The sales. and learnings. subdomains live in their own folders and are not affected.
# ------------------------------------------------------------------

# BEGIN old-site redirects
# Generated by scripts/build-redirects.js — edit that file, not this block.
# Old pages from previous versions of the site, sent to their closest new page.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Spam pages that were injected into the old WordPress site (non-English addresses).
  RewriteCond %{THE_REQUEST} "\s/[^\s]*%[89A-Fa-f][0-9A-Fa-f]"
  RewriteRule ^ - [G,L]

  # Leftover demo-theme and junk pages: gone for good.
  RewriteRule ^api/?$ - [G,L,NC]
  RewriteRule ^atom\.xml/?$ - [G,L,NC]
  RewriteRule ^author/backofficezuviuslifesciences-in/?$ - [G,L,NC]
  RewriteRule ^author/backofficezuviuslifesciences-in/page/2/?$ - [G,L,NC]
