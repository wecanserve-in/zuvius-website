# ------------------------------------------------------------------
# Server rules for zuviuslifesciences.in (Hostinger). Copied into build/ by
# `npm run build`, so it is deployed with the site.
#   1. Sends www visitors to https://zuviuslifesciences.in
#   2. Serves the ready-made page for each address (<address>/index.html)
#   3. Returns a real "404 Not Found" for wrong addresses
#   4. Adds standard security headers
#   5. Lets browsers cache files properly
# The sales. and learnings. subdomains live in their own folders and are not affected.
# ------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. One address for the whole site: no www. (http -> https is handled by
  #    Hostinger's "Force HTTPS" setting; doing it here can loop behind the CDN.)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2. Real files (images, scripts, /api/*.php) are served as they are
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Every page address has a folder with an index.html made by the build
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ $1/index.html [L]
</IfModule>

# 3. Anything else is a wrong address. 404.html loads the site's own
#    "Page not found" page, and the 404 status keeps it out of Google.
ErrorDocument 404 /404.html

# 4. Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# 5. Caching
<IfModule mod_headers.c>
  # Script and style files have a content hash in their name, so they never change
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|mp4|pdf|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Pages must always be checked, so visitors get new releases straight away
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
